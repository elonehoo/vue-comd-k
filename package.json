{
  "name": "@vue-comd-k/monorepo",
  "version": "0.0.3",
  "private": "true",
  "packageManager": "pnpm@12.18.0",
  "description": "Extensible command+k interface for Vue.",
  "scripts": {
    "build": "pnpm -C core run build",
    "docs:dev": "pnpm -C docs run dev",
    "docs:build": "pnpm -C docs run build",
    "example:dev": "pnpm -C example run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "bumpp package.json core/package.json --commit --push --tag && pnpm -r publish --access public"
  },
  "keywords": [
    "command",
    "k",
    "vue"
  ],
  "author": "Elone Hoo <huchengyea@163.com>",
  "license": "MIT",
  "devDependencies": {
    "@elonehoo/eslint-config": "^2.0.0",
    "bumpp": "^12.3.0",
    "eslint": "^10.15.0",
    "pnpm": "12.18.0",
    "rimraf": "^6.1.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "vue": "^3.5.45"
  },
  "engines": {
    "node": "24.22.3"
  }
}
